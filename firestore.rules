rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function validOpId(opId) {
   return opId is string
    && opId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
  }
  function markerPath(uid, opId) {
   return /databases/$(database)/documents/users/$(uid)/appliedOps/$(opId);
  }
  function itemPath(uid, itemId) {
   return /databases/$(database)/documents/users/$(uid)/items/$(itemId);
  }
  match /users/{uid}/items/{itemId} {
   function valid() {
    let d = request.resource.data;
    return d.keys().hasAll(['kind','period','title','body','time','done','days','deleted','updatedAt','lastOpId'])
     && d.keys().hasOnly(['kind','period','title','body','time','done','days','deleted','updatedAt','lastOpId','startDate','createdAt','completedAt'])
     && (!('startDate' in d) || (d.kind == 'routine' && d.startDate is string
       && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
     && d.kind in ['monthly','weekly','daily','routine','memo','bucket','completion','schedule']
     && d.period is string && d.period.size() <= 10
     && ((d.kind == 'monthly' && d.period.matches('^[0-9]{4}-[0-9]{2}$'))
       || (d.kind in ['daily','weekly','completion','schedule'] && d.period.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
       || (d.kind in ['routine','memo','bucket'] && d.period == ''))
     && (d.kind == 'bucket'
       ? (d.keys().hasAll(['createdAt','completedAt'])
         && d.createdAt is int && d.createdAt > 0
         && d.completedAt is string
         && (d.completedAt == '' || d.completedAt.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'))
         && d.done == (d.completedAt != ''))
       : (!('createdAt' in d) && !('completedAt' in d)))
     && d.title is string && d.title.size() <= 300
     && d.body is string && d.body.size() <= 20000
     && d.time is string && (d.time == '' || d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
     && d.done is bool && d.deleted is bool
     && d.days is list && d.days.size() <= 7 && d.days.hasOnly([0,1,2,3,4,5,6])
     && d.updatedAt == request.time
     && validOpId(d.lastOpId);
   }
   function pairedMarker() {
    let opId = request.resource.data.lastOpId;
    return validOpId(opId)
     && !exists(markerPath(uid, opId))
     && getAfter(markerPath(uid, opId)).data.record == itemId
     && getAfter(markerPath(uid, opId)).data.appliedAt == request.time;
   }
   allow read: if owner(uid);
   allow create: if owner(uid) && valid() && pairedMarker();
   allow update: if owner(uid) && valid() && pairedMarker() && request.resource.data.kind == resource.data.kind
     && request.resource.data.period == resource.data.period
     && request.resource.data.get('startDate', null) == resource.data.get('startDate', null)
     && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
     && (!resource.data.deleted || request.resource.data.deleted);
   // Planner deletion is a validated tombstone update, never a hard delete.
   allow delete: if false;
  }
  match /users/{uid}/appliedOps/{opId} {
   function validMarker() {
    let d = request.resource.data;
    return validOpId(opId)
     && d.keys().hasAll(['record','payloadHash','appliedAt'])
     && d.keys().hasOnly(['record','payloadHash','appliedAt'])
     && d.record is string && d.record.size() > 0 && d.record.size() <= 1500
     && d.record.matches('^[^/]+$')
     && d.payloadHash is string && d.payloadHash.matches('^[0-9a-f]{64}$')
     && d.appliedAt == request.time
     && (!exists(itemPath(uid, d.record))
       || get(itemPath(uid, d.record)).data.get('lastOpId', '') != opId)
     && getAfter(itemPath(uid, d.record)).data.lastOpId == opId
     && getAfter(itemPath(uid, d.record)).data.updatedAt == request.time;
   }
   allow read: if owner(uid);
   allow create: if owner(uid) && validMarker();
   allow update, delete: if false;
  }
 }
}
